# Build stage
FROM rust:1.95-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates ./crates

# Build release binary
RUN cargo build --locked --release --bin witness

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder
COPY --from=builder /app/target/release/witness /usr/local/bin/witness

# Create data directory
RUN groupadd --gid 10001 siglog && useradd --uid 10001 --gid siglog --no-create-home siglog \
    && mkdir -p /data && chown siglog:siglog /data
USER 10001:10001

# Default environment variables
ENV LISTEN_ADDR=0.0.0.0:8081
ENV DATABASE_URL=sqlite:/data/witness.db?mode=rwc

EXPOSE 8081

ENTRYPOINT ["witness"]
